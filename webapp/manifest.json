{
  "_version": "1.89.0",
  "sap.app": {
    "id": "northwind",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "dfa90ac9-9717-498f-bd9f-dfcc27fb32c5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/V3/(S(u1pzcgolsmxxlycujoaedttu))/OData/OData.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "northwind.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "maxDataServiceVersion" : "3.0"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "northwind.view",
        "async": true,
        "viewPath": "northwind.view"
      },
      "routes": [
        {
          "name": "RouteProducts",
          "pattern": "",
          "target": [
            "TargetProducts"
          ]
        },
        {
          "name" : "ProductDetailsView",
          "pattern": "Detail/{ID}",
          "target" : [
            "TargetDetailPage"
          ]
        },
        {
          "name" : "View3Page",
          "pattern": "AnotherView/:IIID:",
          "target" : [
            "AnotherViewTarget"
          ]
        }
      ],
      "targets": {
        "TargetProducts": {
          "id": "Products",
          "name": "Products"
        },
        "TargetDetailPage" : {
          "id": "ProductDetails",
          "name": "ProductDetails"
        },
        "AnotherViewTarget" : {
            "id": "View3",
          "name": "View3"
        }
      }
    },
    "rootView": {
      "viewName": "northwind.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
